\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces (a)~Every success rate reported in this paper, with its interval. The two leftmost tour bars contrast guided-tour legs before and after the map and its annotations stopped changing, the largest effect we measured; the coordinate and annotation arms of the bench comparison are indistinguishable ($p=1.00$). (b)~In the field record, the state the robot reports separates success from failure perfectly, while the addressing scheme does not separate them at all. (c)~Median and range of the interaction loop per exchange kind, log scale. Exchanges that only look up an answer sit below \SI {10}{\second }; those that also move the robot sit above it, because the preparation sequence runs inside the loop. A single pooled latency would describe neither group.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:results}{{6}{6}{(a)~Every success rate reported in this paper, with its interval. The two leftmost tour bars contrast guided-tour legs before and after the map and its annotations stopped changing, the largest effect we measured; the coordinate and annotation arms of the bench comparison are indistinguishable ($p=1.00$). (b)~In the field record, the state the robot reports separates success from failure perfectly, while the addressing scheme does not separate them at all. (c)~Median and range of the interaction loop per exchange kind, log scale. Exchanges that only look up an answer sit below \SI {10}{\second }; those that also move the robot sit above it, because the preparation sequence runs inside the loop. A single pooled latency would describe neither group}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Measured indicators, June--July 2026, and what each one is for. Legs within a tour are not independent observations, so the leg-level interval is optimistic. Rows marked $^{\dagger }$ are campaign readings for which no machine-readable log was archived.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:metrics}{{III}{6}{Measured indicators, June--July 2026, and what each one is for. Legs within a tour are not independent observations, so the leg-level interval is optimistic. Rows marked $^{\dagger }$ are campaign readings for which no machine-readable log was archived}{table.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-E}}Comparison with the vendor application}{6}{subsection.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces All \num {34} instrumented guided tours. To the left of the rule, while the map and its annotations were still being edited, one navigation leg in seven succeeded and no tour finished. To the right, \num {180} consecutive legs succeeded with no navigation failure and 17 tours ran end to end, the last ten of them in one uninterrupted campaign. Operator stops are not failures: every leg they had attempted had succeeded. The two late aborts ended on a speech failure, not a navigation one.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:tourtimeline}{{7}{7}{All \num {34} instrumented guided tours. To the left of the rule, while the map and its annotations were still being edited, one navigation leg in seven succeeded and no tour finished. To the right, \num {180} consecutive legs succeeded with no navigation failure and 17 tours ran end to end, the last ten of them in one uninterrupted campaign. Operator stops are not failures: every leg they had attempted had succeeded. The two late aborts ended on a speech failure, not a navigation one}{figure.7}{}}
