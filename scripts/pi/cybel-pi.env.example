# Configuration du backend CYBEL sur le Raspberry Pi — NON SECRÈTE.
# Copié en ~/cybel/cybel-pi.env au premier déploiement (scripts/deploy_pi.sh),
# jamais écrasé ensuite : modifier le fichier sur le Pi, puis
#     systemctl --user restart cybel
# Le jeton de l'agent de la tête est à part, dans ~/cybel/.secrets.env.

# Port HTTP du backend (même port que le backend de test de la tête).
BACKEND_PORT=8001

# rosbridge du châssis, joignable quand le Pi est sur le Wi-Fi du robot (TY1251D-03195).
# Hors du robot, la connexion échoue et le backend réessaie : sans effet.
ROBOT_HOST=10.42.0.1
ROBOT_WS_PORT=9090

# Agent de la tête (scripts/termux/head_agent.py), ex. http://<ip-tête>:8002
# Vide : voix, enrôlement facial et écran du dessous échouent proprement (signalés « ok: false »).
CYBEL_HEAD_AGENT_URL=
