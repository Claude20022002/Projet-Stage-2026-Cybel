<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cybel.secondscreen"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="25" />

    <!-- Fenêtre sur l'écran HDMI depuis un Service (pas d'Activity) : accordé par
         « appops set com.cybel.secondscreen SYSTEM_ALERT_WINDOW allow » (cf. build.sh). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="CybelSecondScreen"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false">

        <service
            android:name=".SecondScreenService"
            android:exported="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
